{
  "schemaVersion": "website-2.0",
  "pluginVersion": "2.0.0-preview.3",
  "risk": {
    "name": "whole_document_risks",
    "strict": true,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source_clause_id",
              "quote",
              "affected_party_id",
              "legal_effect",
              "why_adverse",
              "severity",
              "certainty",
              "recommendation",
              "suggested_clause",
              "duplicate_of",
              "azerbaijani_explanation"
            ],
            "properties": {
              "azerbaijani_explanation": {
                "description": "Additional Azerbaijani explanation for foreign-language findings; null when the explanation is already Azerbaijani. Display only, never replacement text.",
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "quote": {
                        "type": "string",
                        "description": "Azerbaijani translation of the exact quote, for reading only; never source evidence."
                      },
                      "suggestion": {
                        "type": "string",
                        "description": "Azerbaijani translation of suggested_clause, for reading only; empty when suggested_clause is empty."
                      },
                      "issue": {
                        "type": "string",
                        "description": "Azerbaijani translation of the issue / legal_effect."
                      },
                      "impact": {
                        "type": "string",
                        "description": "Azerbaijani translation of analysis / why_adverse, preserving party, uncertainty and meaning."
                      },
                      "recommendation": {
                        "type": "string",
                        "description": "Explain the same recommendation or grammar correction in Azerbaijani; do not draft a translated replacement clause."
                      }
                    },
                    "required": [
                      "quote",
                      "suggestion",
                      "issue",
                      "impact",
                      "recommendation"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "id": {
                "type": "string"
              },
              "source_clause_id": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "description": "Exact contiguous quote within the source unit. Never quote a comment."
              },
              "affected_party_id": {
                "type": "string",
                "description": "Copy the affected party ID; use unclear if attribution cannot be established."
              },
              "legal_effect": {
                "type": "string"
              },
              "why_adverse": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "certainty": {
                "type": "string",
                "enum": [
                  "clear",
                  "plausible"
                ]
              },
              "recommendation": {
                "type": "string"
              },
              "suggested_clause": {
                "type": "string",
                "description": "Minimal replacement for exactly quote, or empty if unsafe or uncertain."
              },
              "duplicate_of": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Earlier finding ID only when source occurrence, harmed party and legal effect are the same."
              }
            }
          }
        }
      }
    }
  },
  "grammar": {
    "name": "whole_document_grammar",
    "strict": true,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "azerbaijani_explanation": {
                "description": "Additional Azerbaijani explanation for foreign-language findings; null when the explanation is already Azerbaijani. Display only, never replacement text.",
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "quote": {
                        "type": "string",
                        "description": "Azerbaijani translation of the exact quote, for reading only; never source evidence."
                      },
                      "suggestion": {
                        "type": "string",
                        "description": "Azerbaijani translation of suggested_clause, for reading only; empty when suggested_clause is empty."
                      },
                      "issue": {
                        "type": "string",
                        "description": "Azerbaijani translation of the issue / legal_effect."
                      },
                      "impact": {
                        "type": "string",
                        "description": "Azerbaijani translation of analysis / why_adverse, preserving party, uncertainty and meaning."
                      },
                      "recommendation": {
                        "type": "string",
                        "description": "Explain the same recommendation or grammar correction in Azerbaijani; do not draft a translated replacement clause."
                      }
                    },
                    "required": [
                      "quote",
                      "suggestion",
                      "issue",
                      "impact",
                      "recommendation"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "clause_number": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quote": {
                "type": "string",
                "description": "The smallest exact contiguous source span that needs this correction. Do not copy an entire paragraph for a word-level error."
              },
              "suggested_clause": {
                "type": "string",
                "description": "Minimal replacement for quote only, preserving its legal meaning."
              },
              "issue": {
                "type": "string",
                "description": "A short label naming this grammar error."
              },
              "analysis": {
                "type": "string",
                "description": "One concise sentence explaining this correction. Retain every distinct real error; brevity applies to explanations, not review coverage."
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "source_anchor": {
                "type": "string",
                "description": "The shortest exact contiguous source excerpt containing quote exactly once and occurring exactly once in the complete document. Add only enough surrounding words to distinguish repeated text. The website reconstructs the full paragraph locally; do not copy it here unless needed to disambiguate."
              }
            },
            "required": [
              "azerbaijani_explanation",
              "clause_number",
              "quote",
              "suggested_clause",
              "issue",
              "analysis",
              "confidence",
              "source_anchor"
            ]
          }
        }
      }
    }
  },
  "comparison": {
    "name": "document_comparison",
    "strict": true,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "limitations",
        "findings"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "location",
              "beforeQuote",
              "afterQuote",
              "explanation",
              "effect",
              "affectedParty",
              "impact",
              "recommendation"
            ],
            "properties": {
              "location": {
                "type": "string"
              },
              "beforeQuote": {
                "type": "string"
              },
              "afterQuote": {
                "type": "string"
              },
              "explanation": {
                "type": "string"
              },
              "effect": {
                "type": "string",
                "enum": [
                  "beneficial",
                  "adverse",
                  "neutral",
                  "uncertain"
                ]
              },
              "affectedParty": {
                "type": "string"
              },
              "impact": {
                "type": "string"
              },
              "recommendation": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "review": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "query",
      "documentName",
      "answer",
      "model",
      "generatedAt",
      "references",
      "documentReview"
    ],
    "properties": {
      "query": {
        "type": "string"
      },
      "documentName": {
        "type": "string"
      },
      "answer": {
        "type": "string"
      },
      "model": {
        "type": "string"
      },
      "generatedAt": {
        "type": "string"
      },
      "references": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "documentReview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentName",
          "documentText",
          "sourceDocumentText",
          "findings",
          "rejectedFindings",
          "humanReview",
          "provenance"
        ],
        "properties": {
          "documentName": {
            "type": "string"
          },
          "documentText": {
            "type": "string"
          },
          "sourceDocumentText": {
            "type": "string"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "quote",
                "issue",
                "riskLevel",
                "status",
                "riskType",
                "confidence",
                "legalBasis",
                "referenceIndexes",
                "recommendation",
                "detection_source",
                "remediation_mode",
                "source_span"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "issue": {
                  "type": "string"
                },
                "riskLevel": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "riskType": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number"
                },
                "legalBasis": {
                  "type": "string"
                },
                "referenceIndexes": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "recommendation": {
                  "type": "string"
                },
                "suggested_clause": {
                  "type": "string"
                },
                "replacement": {
                  "type": "string"
                },
                "detection_source": {
                  "type": "string"
                },
                "remediation_mode": {
                  "type": "string"
                },
                "source_span": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "end",
                    "text"
                  ],
                  "properties": {
                    "start": {
                      "type": "number"
                    },
                    "end": {
                      "type": "number"
                    },
                    "text": {
                      "type": "string"
                    }
                  }
                },
                "analysis": {
                  "type": "string"
                },
                "affected_party_id": {
                  "type": "string"
                },
                "why_risky_for_selected_party": {
                  "type": "string"
                }
              }
            }
          },
          "rejectedFindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "quote",
                "issue",
                "reason"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "issue": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "humanReview": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "issue",
                "reason"
              ],
              "properties": {
                "issue": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pluginVersion",
              "schemaVersion",
              "model",
              "reasoning",
              "documentHash",
              "promptFingerprint"
            ],
            "properties": {
              "pluginVersion": {
                "type": "string"
              },
              "schemaVersion": {
                "const": "website-2.0"
              },
              "model": {
                "type": "string"
              },
              "reasoning": {
                "type": "string"
              },
              "documentHash": {
                "type": "string"
              },
              "promptFingerprint": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
